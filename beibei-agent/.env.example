# ============================================================================
#  背备不悲 · beibei-agent 配置模板
#  复制为 .env 后填入真实值
# ============================================================================

# ---------- 服务 ----------
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# Java 与 Python 之间的内部调用令牌，两边必须一致
# ⚠️ 也可以用环境变量 BEIBEI_INTERNAL_TOKEN 覆盖 Java 侧的配置
INTERNAL_TOKEN=change_me_to_a_random_string
# API Key 的 AES 加密口令，必须与 Java 侧 beibei.security.secret 完全一致
# ⚠️ 改这个值会让数据库里已加密的 API Key 解不开，需要在界面上重新填一次
SECRET_KEY=change_me_to_another_random_string
LOG_LEVEL=INFO
DEBUG=true

# ---------- MySQL ----------
MYSQL_HOST=192.168.1.100
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=beibei

# ---------- Milvus ----------
MILVUS_HOST=192.168.1.100
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=bb_chunk
MILVUS_PARTITION_PREFIX=kb_

# ---------- 向量化 ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=16

# ---------- OCR ----------
OCR_LANG=ch
OCR_USE_GPU=false

# ---------- LLM ----------
LLM_PROVIDER=deepseek

# ⚠️ 最重要的一个开关，别忽略它 ——
#   true  = 本地 Mock 模式：用 app/services/mock_llm.py 的规则法，
#           真的从材料/简历里抽句子套模板，不花一分钱，链路能完整跑通。
#           但**输出很粗浅**：面试永远问「你简历里写了 X，说说怎么用的」，
#           不会顺着你的回答追问；评分每轮都差不多。
#           只在「还没有 Key、只想验证流程」时用。
#   false = 走 bb_ai_provider 里启用的真实厂商（下一个字段只是兜底）。
# 症状识别：AI 不报错但明显不聪明 → 先看这个开关，
#          再看健康检查里显示的模型名（Mock 模式会显示成 mock-llm）。
LLM_MOCK=false

DEEPSEEK_BASE_URL=https://api.deepseek.com
# 留空也可以：运行时优先用数据库 bb_ai_provider 里 enabled=1 且 is_active=1 的厂商
# （在「设置 → AI 配置」里填，Key 会做 AES 加密存库），这里只是数据库没配时的兜底。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------- ASR ----------
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# ---------- 媒体处理 ----------
FFMPEG_PATH=ffmpeg

# ---------- RAG ----------
RAG_TOP_K=8
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
CHUNK_SIZE=700
CHUNK_OVERLAP=105

# ---------- 路径 ----------
UPLOAD_DIR=D:/beibei-data/upload
