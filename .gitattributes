# ============================================================================
#  统一换行符与文本处理
#
#  为什么需要：Windows 上 git 默认会把 LF 转成 CRLF（core.autocrlf=true），
#  于是同一次提交在不同系统上产生大量「明明没改却显示全文件改动」的噪音 diff。
#  这里显式声明：源码一律用 LF，二进制不动。
# ============================================================================

# 默认：由 git 判断是否文本文件，文本一律存成 LF
* text=auto eol=lf

# ---------- 明确按文本处理 ----------
*.md      text eol=lf
*.txt     text eol=lf
*.py      text eol=lf
*.java    text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.sql     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.properties text eol=lf

# Windows 脚本必须保留 CRLF，否则在某些环境下执行异常
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ---------- 二进制：不要动 ----------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.jar     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.pcm     binary
*.wav     binary
*.webm    binary
*.mp3     binary

# ---------- 语言统计：把这些标记为文档，别算进代码行数 ----------
package-lock.json  linguist-generated=true
*.sql              linguist-language=SQL
